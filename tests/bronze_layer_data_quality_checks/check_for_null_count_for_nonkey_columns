/*
===============================================================================
Quality Checks: check_for_null_count_for_nonkey_columns
===============================================================================
Purpose:
    Checks each non-key column across all 9 Bronze tables for NULL counts. 
    Some NULLs are expected (e.g. delivery dates for undelivered orders, or known gaps in the source Olist dataset) — this check quantifies them 
    rather than assuming they're a problem, and flags any that look like genuine data quality issues.
===============================================================================
*/


-- Check NULL counts for each non-key column in olist_orders
-- Expectation: null_order_status = 0, null_purchase_timestamp = 0; delivery-related columns may show non-zero counts for undelivered orders which is cross-checked against order_status
SELECT 
	COUNT(*) AS total_rows,
	COUNT(*) FILTER (WHERE order_status IS NULL) AS null_order_status,
	COUNT(*) FILTER (WHERE order_purchase_timestamp IS NULL) AS null_order_purchase_timestamp,
	COUNT(*) FILTER (WHERE order_approved_at IS NULL) AS null_order_approved_at,
	COUNT(*) FILTER (WHERE order_delivered_carrier_date IS NULL) AS null_order_delivered_carrier_date,
	COUNT(*) FILTER (WHERE order_delivered_customer_date IS NULL) AS null_order_delivered_customer_date,
	COUNT(*) FILTER (WHERE order_estimated_delivery_date IS NULL) AS null_order_estimated_delivery_date
FROM bronze.olist_orders;
-- Result: 160 null values for order_approved_at column, 1783 null values for order_delivered_carrier_date column, 2965 null values for order_delivered_customer_date column
 
 
-- Check if NULL delivery dates correlate with non-delivered order_status?
-- Expectation: NULLs in approved_at/delivered_carrier_date/delivered_customer_date should concentrate in non-'delivered' statuses (shipped, invoiced, processing, canceled, unavailable, created). 
-- 'delivered' orders should have 0 NULLs across all three date columns, since a delivered order should have a full timestamp trail.
SELECT order_status, 
	COUNT(*) AS total,
	COUNT(*) FILTER (WHERE order_approved_at IS NULL) AS null_order_approved_at,
	COUNT(*) FILTER (WHERE order_delivered_carrier_date IS NULL) AS null_order_delivered_carrier_date,
	COUNT(*) FILTER (WHERE order_delivered_customer_date IS NULL) AS null_order_delivered_customer_date
FROM bronze.olist_orders
GROUP BY order_status
ORDER BY total DESC;
--- Result: NULL delivery dates concentrate in non-delivered statuses (shipped, invoiced, processing, unavailable). 
-- 	However, two logical inconsistencies found:
-- 	1. 8 out of 96,478 'delivered' orders have NULL delivered_customer_date — status says delivered but no delivery timestamp exists.
-- 	2. 'canceled' orders show a fulfillment funnel that shouldn't exist for a canceled order: 484 out of 625 have order_approved_at populated (order was approved before cancellation), 
--     75 even have order_delivered_carrier_date populated (handed to carrier before cancellation), and 
--     6 have a non-NULL order_delivered_customer_date — meaning the order was recorded as delivered to the customer while its status simultaneously says 'canceled', which is contradictory.
 


-- Check whether review_comment_title contains empty strings distinct from NULLs
-- Expectation: quantify both categories separately
SELECT 
    COUNT(*) AS total_rows,
    COUNT(*) FILTER (WHERE review_comment_title IS NULL) AS null_count,
    COUNT(*) FILTER (WHERE review_comment_title = '') AS empty_string_count,
    COUNT(*) FILTER (WHERE review_comment_title IS NOT NULL AND review_comment_title != '') AS populated_count
FROM bronze.olist_order_reviews;
-- Result: 0 empty_string_count and 87656 NULL values



-- Check for unexpected characters in customer_city (digits, symbols, encoding corruption) that shouldn't appear in a city name
-- Expectation: only expected characters returned — letters, Portuguese accents, spaces, hyphens, apostrophes
SELECT DISTINCT character
FROM (
    SELECT unnest(regexp_split_to_array(customer_city, '')) AS character
    FROM bronze.olist_customers
    WHERE customer_city ~ '[^a-záàâãéêíóôõúüçA-ZÁÀÂÃÉÊÍÓÔÕÚÜÇ\s''-]'
) sub
WHERE character ~ '[^a-záàâãéêíóôõúüçA-ZÁÀÂÃÉÊÍÓÔÕÚÜÇ\s''-]';
-- Result: 2 unexpected characters found


-- Find the actual city names containing the unexpected digit characters
-- Expectation: identify the source rows to determine if this is a genuine data quality issue or a legitimate city name
SELECT DISTINCT customer_city, COUNT(*)
FROM bronze.olist_customers
WHERE customer_city ~ '[0-9]'

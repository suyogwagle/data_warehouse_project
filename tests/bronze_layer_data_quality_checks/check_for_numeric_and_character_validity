-- geolocation
-- Check for any unexpected characters in geolocation_city (non-letter, non-accent, non-space/hyphen/apostrophe)
-- Expectation: 0 rows returned
SELECT geolocation_city
FROM bronze.olist_geolocation
WHERE geolocation_city ~ '[^a-záàâãéêíóôõúüçA-ZÁÀÂÃÉÊÍÓÔÕÚÜÇ\s''-]';
-- Result: 32 rows returned where unexpected characters exist


-- Check exactly which unexpected characters are present, and how many distinct cities / total rows each affects
-- Expectation: only genuinely problematic characters
SELECT character, COUNT(DISTINCT original_value) AS distinct_cities_affected, 
       COUNT(*) AS total_occurrences
FROM (
    SELECT geolocation_city AS original_value,
           unnest(regexp_split_to_array(geolocation_city, '')) AS character
    FROM bronze.olist_geolocation
    WHERE geolocation_city ~ '[^a-záàâãéêíóôõúüçA-ZÁÀÂÃÉÊÍÓÔÕÚÜÇ\s''-]'
) sub
WHERE character ~ '[^a-záàâãéêíóôõúüçA-ZÁÀÂÃÉÊÍÓÔÕÚÜÇ\s''-]'
GROUP BY character
ORDER BY total_occurrences DESC;
-- Result: 18 distinct unexpected characters found


-- Check the actual city names behind each unexpected character
-- Expectation: records with unexpected characters in them
SELECT DISTINCT original_value AS geolocation_city, character
FROM (
    SELECT geolocation_city AS original_value,
           unnest(regexp_split_to_array(geolocation_city, '')) AS character
    FROM bronze.olist_geolocation
    WHERE geolocation_city ~ '[^a-záàâãéêíóôõúüçA-ZÁÀÂÃÉÊÍÓÔÕÚÜÇ\s''-]'
) sub
WHERE character ~ '[^a-záàâãéêíóôõúüçA-ZÁÀÂÃÉÊÍÓÔÕÚÜÇ\s''-]'
ORDER BY character, original_value;
-- Result: 49 distinct records returned and the manual review of the returned values identified 4 categories:
-- 1. HTML entity / encoding corruption (genuine issue) — e.g. 'lambari d%26apos%3boeste' → should be 'lambari d''oeste', 'sa£o paulo' → should be 'são paulo', etc
-- 2. Legitimate parenthetical sub-locality names, e.g. 'antunes (igaratinga)', 'jacare (cabreuva)'
-- 3. Legitimate numbered place names, e.g. 'quilometro 14 do mutum', 'riacho fundo 2', 'colonia z-3'
-- 4. Structural issue: 2 values contain embedded "city, state, country" instead of just city, e.g. 'rio de janeiro, rio de janeiro, brasil'
-- 5. Likely junk/placeholder: '* cidade'


-- Check specifically the confirmed HTML entity / encoding corruption cases
-- Expectation: specific list of values needing string cleanup
SELECT DISTINCT geolocation_city
FROM bronze.olist_geolocation
WHERE geolocation_city LIKE '%&%' 
   OR geolocation_city LIKE '%\%%'
   OR geolocation_city LIKE '%£%'
   OR geolocation_city LIKE '%³%'
   OR geolocation_city LIKE '%´%'
   OR geolocation_city LIKE '%`%';
-- Result: 7 distinct values confirmed as genuine encoding corruption



/*
===============================================================================
Quality Checks: check_for_numeric_and_character_validity
===============================================================================
Purpose:
    Verifies that columns intended to hold numeric or date values actually contain valid, castable data (since all Bronze columns are stored as VARCHAR per the raw fidelity principle). 
    Also investigates unexpected characters in free-text/place-name columns to separate genuine data quality issues from legitimate values.
===============================================================================
*/


-- order_items
-- Check for non-numeric values in price and freight_value in olist_order_items
-- Expectation: 0 rows returned
SELECT order_id, price, freight_value
FROM bronze.olist_order_items
WHERE price !~ '^\d+(\.\d+)?$' 
   OR freight_value !~ '^\d+(\.\d+)?$';
-- Result: 0 rows returned


-- Check for invalid shipping_limit_date values in olist_order_items
-- Expectation: 0 rows returned
SELECT order_id, shipping_limit_date
FROM bronze.olist_order_items
WHERE shipping_limit_date !~ '^\d{2}/\d{2}/\d{4} \d{2}:\d{2}$';
-- Result: 0 rows returned



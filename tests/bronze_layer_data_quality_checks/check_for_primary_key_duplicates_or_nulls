/*
===============================================================================
Quality Checks: check_for_primary_key_duplicates_or_nulls
===============================================================================
Purpose:
    Verifies that each Bronze table's expected primary key (or composite key) has no duplicate values and no NULLs. 
    Findings inform key design for the Silver and Gold layers.
===============================================================================
*/


-- Check for NULLs or duplicates in potential primary key of olist_customers table
-- Expectation: 0 rows returned
SELECT customer_id, COUNT(*) 
FROM bronze.olist_customers
GROUP BY customer_id
HAVING COUNT(*) > 1 OR customer_id IS NULL;
-- Result: 0 rows returned — no exact duplicates or NULL hence a primary key
 

-- Check for NULLs or duplicates in potential primary key order_id of olist_order_items table
-- Expectation: 0 rows returned
SELECT order_id, COUNT(*)
FROM bronze.olist_order_items
GROUP BY order_id
HAVING COUNT(*) > 1 OR order_id IS NULL;
-- Result: 9803 rows returned - exact duplicates are there hence not a priamry key


-- Check for NULLs or duplicates in potential primary key order_item_id of olist_order_items table
-- Expectation: 0 rows returned
SELECT order_item_id, COUNT(*)
FROM bronze.olist_order_items
GROUP BY order_item_id
HAVING COUNT(*) > 1 OR order_item_id IS NULL;
-- Result: 20 rows returned - exact duplicates are there hence not a primary key


-- Check for NULLs or duplicates in potential composite primary key (order_id, order_item_id) of olist_order_items table
-- Expectation: 0 rows returned
SELECT order_id, order_item_id, CONCAT(order_id, '-', order_item_id), COUNT(*)
FROM bronze.olist_order_items
GROUP BY order_id, order_item_id
HAVING COUNT(*) > 1 OR order_id IS NULL OR order_item_id IS NULL;
-- Result: 0 rows returned — no duplicates found hence (order_id, order_item_id) is the true composite primary key
 
 
-- Check: normalized (cast) composite key, catch formatting mismatches like '01' vs '1' that a string-based check would miss.
-- Expectation: 0 rows returned
SELECT order_id, CAST(order_item_id AS INT) AS normalized_item_id, COUNT(*), 
       STRING_AGG(DISTINCT order_item_id, ', ') AS raw_variants
FROM bronze.olist_order_items
GROUP BY order_id, CAST(order_item_id AS INT)
HAVING COUNT(*) > 1;
-- Result: 0 rows returned — no formatting-based duplicates found.
 


-- Check for exact duplicate rows in olist_geolocation
-- Expectation: some duplicates are acceptable here, this is exploratory 
-- (geolocation has no natural single-column key; multiple delivery points can legitimately share the same zip/lat/lng)
SELECT geolocation_zip_code_prefix, geolocation_lat, geolocation_lng, 
       geolocation_city, geolocation_state, COUNT(*)
FROM bronze.olist_geolocation
GROUP BY geolocation_zip_code_prefix, geolocation_lat, geolocation_lng, 
         geolocation_city, geolocation_state

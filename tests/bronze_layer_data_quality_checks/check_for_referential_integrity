-- Check if every product_category_name in olist_products exists in olist_product_category_name_translation
-- Expectation: 0 rows returned
SELECT p.product_category_name, t.product_category_name AS matched_product_category_name
FROM bronze.olist_products p
LEFT JOIN bronze.olist_product_category_name_translation t ON p.product_category_name = t.product_category_name
WHERE t.product_category_name IS NULL;
-- Result: 623 rows returned - maximum null values


-- Narrow down the unmatched category names, excluding NULLs 
-- Expectation: rows with no_matched_product_category_name returned without any null values
SELECT p.product_category_name
FROM bronze.olist_products p
LEFT JOIN bronze.olist_product_category_name_translation t 
    ON p.product_category_name = t.product_category_name
WHERE t.product_category_name IS NULL 
  AND p.product_category_name IS NOT NULL;
-- Result: shows the distinct unmatched category names - 13 such rows exist with 2 values, excluding NULL product_category_name rows



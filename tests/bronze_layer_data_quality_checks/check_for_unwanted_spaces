/*
===============================================================================
Quality Checks: check_for_unwanted_spaces
===============================================================================
Purpose:
    Checks each Bronze table's text columns for leading/trailing whitespace using TRIM(). Findings inform which columns need trimming in the Silver 
    layer transformation.
===============================================================================
*/


-- Check for unwanted spaces in olist_customers table
-- Expectation: 0 rows returned
SELECT * FROM bronze.olist_customers
WHERE customer_id != TRIM(customer_id) OR 
      customer_unique_id != TRIM(customer_unique_id) OR 
      customer_zip_code_prefix != TRIM(customer_zip_code_prefix) OR 
      customer_city != TRIM(customer_city) OR
      customer_state != TRIM(customer_state);
-- Result: 0 rows returned


-- Check for unwanted spaces in olist_geolocation table
-- Expectation: 0 rows returned
SELECT * FROM bronze.olist_geolocation
WHERE geolocation_zip_code_prefix != TRIM(geolocation_zip_code_prefix) OR
      geolocation_lat != TRIM(geolocation_lat) OR
      geolocation_lng != TRIM(geolocation_lng) OR
      geolocation_city != TRIM(geolocation_city) OR
      geolocation_state != TRIM(geolocation_state);

SELECT * FROM bronze.olist_geolocation
WHERE geolocation_city != TRIM(geolocation_city);
-- Result: 1 row returned, issue was in geolocation_city

-- Check the length of the data that had unwanted space 
-- Expectation: length of the actual record and length of the record after trimming
SELECT LENGTH(geolocation_city), LENGTH(TRIM(geolocation_city)) FROM bronze.olist_geolocation
WHERE LENGTH(geolocation_city) != LENGTH(TRIM(geolocation_city));
-- Result: length of the actual record = 9, length of the record after trimming = 8



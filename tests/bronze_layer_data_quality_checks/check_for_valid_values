-- Check if the price and freight_value are valid in olist_order_items
-- Expected: 0 rows returned
SELECT order_id, price, freight_value
FROM bronze.olist_order_items
WHERE CAST(price AS FLOAT) < 0 OR 
      CAST(freight_value AS FLOAT) < 0;
-- Result: 0 rows returned



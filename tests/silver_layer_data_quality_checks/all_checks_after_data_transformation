-- Logical Date Ordering Checks (olist_orders)

-- Check: order_approved_at should not occur before order_purchase_timestamp
-- Expectation: 0 rows returned
SELECT order_id, order_purchase_timestamp, order_approved_at
FROM silver.olist_orders
WHERE order_approved_at IS NOT NULL
  AND order_approved_at < order_purchase_timestamp;
-- Result: 0 rows returned


-- Check: order_delivered_carrier_date should not occur before order_approved_at
-- Expectation: 0 rows returned
SELECT order_id, order_approved_at, order_delivered_carrier_date
FROM silver.olist_orders
WHERE order_approved_at IS NOT NULL
  AND order_delivered_carrier_date IS NOT NULL
  AND order_delivered_carrier_date < order_approved_at;
-- Result: 1358 rows returned


-- Check how large the "wrong-order" gap actually is
-- Expectation: exploratory, informs severity classification
SELECT order_id, order_approved_at, order_delivered_carrier_date,
       order_approved_at - order_delivered_carrier_date AS gap
FROM silver.olist_orders
WHERE order_approved_at IS NOT NULL
  AND order_delivered_carrier_date IS NOT NULL
  AND order_delivered_carrier_date < order_approved_at
ORDER BY gap DESC;
-- Result: gap ranges from 1 minute to 171 days


-- Break down the gap into minor (likely logging-order artifact) vs severe (likely genuine source data timestamp error), using a 1-day threshold
-- Expectation: exploratory, informs dwh_data_quality_flag design
SELECT 
    CASE 
        WHEN order_approved_at - order_delivered_carrier_date <= INTERVAL '1 day' THEN 'minor (<= 1 day)'
        ELSE 'severe (> 1 day)'
    END AS gap_severity,
    COUNT(*)
FROM silver.olist_orders
WHERE order_approved_at IS NOT NULL
  AND order_delivered_carrier_date IS NOT NULL
  AND order_delivered_carrier_date < order_approved_at
GROUP BY gap_severity;
-- Result: 901 minor (<= 1 day), 457 severe (> 1 day)


-- Check: order_delivered_customer_date should not occur before order_delivered_carrier_date
